#!/usr/bin/env bash
# Explicit entry: ./dharm <command> …
# Bootstraps .venv + editable install on first run.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="${ROOT}/.venv"
PY="${VENV}/bin/python"
PIP="${VENV}/bin/pip"
DHARM="${VENV}/bin/dharm"

bootstrap() {
  echo "[dharm] preparing .venv …" >&2
  python3 -m venv "${VENV}"
  "${PIP}" install -e "${ROOT}"
}

if [[ ! -x "${PY}" ]]; then
  bootstrap
elif [[ ! -x "${DHARM}" ]]; then
  echo "[dharm] installing package into .venv …" >&2
  "${PIP}" install -e "${ROOT}"
fi

exec "${DHARM}" "$@"
